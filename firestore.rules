rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Allow user to update their profile or allow authenticated system updates (like stats/rank)
      allow update: if isAuthenticated();
    }

    // Rooms / Online Matchmaking & Game State Collection Rules
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      
      // Allow creation if authenticated and user is designated as playerX or host
      allow create: if isAuthenticated() && (
        request.resource.data.playerX == request.auth.uid ||
        request.resource.data.hostId == request.auth.uid
      );
      
      // Allow updates if user is either playerX or playerO, or joining an open room
      allow update: if isAuthenticated() && (
        resource.data.playerX == request.auth.uid ||
        resource.data.playerO == request.auth.uid ||
        resource.data.playerO == null ||
        request.resource.data.playerO == request.auth.uid ||
        request.resource.data.status == 'waiting' ||
        request.resource.data.status == 'playing' ||
        request.resource.data.status == 'finished' ||
        request.resource.data.status == 'abandoned'
      );

      // Allow room deletion by host/players
      allow delete: if isAuthenticated() && (
        resource.data.playerX == request.auth.uid ||
        resource.data.hostId == request.auth.uid
      );
    }

    // Matchmaking Queue Collection Rules for Quick Match
    match /matchmaking/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == ticketId;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}
